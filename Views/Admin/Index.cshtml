@model IEnumerable<StudentIdentityPortal.Models.ApplicationUser>
@{ ViewData["Title"] = UiText.Get("admin.title"); }
<section class="content-page page-shell"><div class="page-heading"><div><div class="eyebrow">@UiText.Get("admin.eyebrow")</div><h1>@UiText.Get("admin.heading")</h1><p>@UiText.Get("admin.desc")</p></div><span class="count-pill">@Model.Count() @UiText.Get("students.title").ToLowerInvariant()</span></div>
 @if (TempData["Notice"] is string notice) { <div class="notice">@notice</div> } @if (TempData["Error"] is string error) { <div class="validation-summary">@error</div> }
 <div class="table-wrap"><table class="student-table"><thead><tr><th>@UiText.Get("admin.student")</th><th>@UiText.Get("register.email")</th><th>@UiText.Get("admin.joined")</th><th><span class="sr-only">@UiText.Get("admin.remove")</span></th></tr></thead><tbody>@foreach (var student in Model) { <tr><td><span class="table-person"><span class="table-avatar">@student.FirstName[..1].ToUpperInvariant()</span><strong>@student.FirstName @student.LastName</strong></span></td><td>@student.Email</td><td>@student.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</td><td><form asp-action="DeleteStudent" method="post"><input type="hidden" name="id" value="@student.Id" /><button type="submit" class="button button-danger button-small">@UiText.Get("admin.remove")</button></form></td></tr> }</tbody></table></div>
</section>
