@model IEnumerable<StudentIdentityPortal.Models.ApplicationUser>
@{ ViewData["Title"] = "Admin dashboard"; }
<section class="content-page page-shell"><div class="page-heading"><div><div class="eyebrow">PORTAL MANAGEMENT</div><h1>Admin <span class="text-accent">dashboard.</span></h1><p>Manage student accounts and keep the community in good shape.</p></div><span class="count-pill">@Model.Count() students</span></div>
 @if (TempData["Notice"] is string notice) { <div class="notice">@notice</div> } @if (TempData["Error"] is string error) { <div class="validation-summary">@error</div> }
 <div class="table-wrap"><table class="student-table"><thead><tr><th>Student</th><th>Email</th><th>Joined</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody>@foreach (var student in Model) { <tr><td><span class="table-person"><span class="table-avatar">@student.FirstName[..1].ToUpperInvariant()</span><strong>@student.FirstName @student.LastName</strong></span></td><td>@student.Email</td><td>@student.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</td><td><form asp-action="DeleteStudent" method="post" onsubmit="return confirm('Remove this student account? This cannot be undone.');"><input type="hidden" name="id" value="@student.Id" /><button type="submit" class="button button-danger button-small">Remove</button></form></td></tr> }</tbody></table></div>
</section>
