@model StudentIdentityPortal.ViewModels.DashboardViewModel
@{ ViewData["Title"] = UiText.Get("nav.dashboard"); }
<section class="dashboard page-shell">
  <div class="dashboard-top">
    <div><div class="eyebrow"><span class="eyebrow-dot"></span> @UiText.Get("dash.eyebrow")</div><h1>@UiText.Get("dash.greeting") <span class="text-accent">@Model.DisplayName.Split(' ')[0].</span></h1><p>@UiText.Get("dash.subtitle")</p></div>
    <span class="role-badge">@Model.Role</span>
  </div>
  @if (TempData["Notice"] is string notice) { <div class="notice">@notice</div> }
  <div class="dashboard-grid">
    <article class="welcome-panel">
      <div class="panel-top"><span class="panel-overline">@UiText.Get("dash.identity")</span><span class="verified">✓ @UiText.Get("dash.verified")</span></div>
      <div class="large-avatar">@Model.DisplayName[..1].ToUpperInvariant()</div><h2>@Model.DisplayName</h2><p>@Model.Email</p>
      <div class="welcome-divider"></div><div class="member-line"><span>@UiText.Get("dash.memberSince")</span><strong>@Model.CreatedAt.ToLocalTime().ToString("MMMM yyyy")</strong></div>
      <a class="text-link" asp-controller="Profile" asp-action="Index">@UiText.Get("dash.editProfile") <span>→</span></a>
    </article>
    <div class="dashboard-side">
      @if (User.IsInRole("Admin"))
      {
        <article class="quick-card"><div class="quick-icon quick-purple">✓</div><div><span class="panel-overline">@UiText.Get("dash.studentSpace")</span><h3>@Model.StudentCount @UiText.Get("students.title").ToLowerInvariant()</h3><p>@UiText.Get("dash.adminHint")</p><a class="text-link" asp-controller="Admin" asp-action="Index">@UiText.Get("dash.openAdmin") <span>→</span></a></div></article>
      }
      else
      {
        <article class="quick-card quick-card-warm"><div class="quick-icon quick-peach">→</div><div><span class="panel-overline">@UiText.Get("dash.studentSpace")</span><h3>@UiText.Get("dash.keepProfile")</h3><p>@UiText.Get("dash.profileHint")</p><a class="text-link" asp-controller="Profile" asp-action="Index">@UiText.Get("dash.updateProfile") <span>→</span></a></div></article>
      }
    </div>
  </div>
</section>
