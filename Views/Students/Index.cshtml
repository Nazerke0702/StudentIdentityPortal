@model IEnumerable<StudentIdentityPortal.ViewModels.StudentViewModel>
@{ ViewData["Title"] = UiText.Get("students.title"); }
<section class="content-page page-shell"><div class="page-heading"><div><div class="eyebrow">@UiText.Get("students.eyebrow")</div><h1>@UiText.Get("students.heading")</h1><p>@UiText.Get("students.desc")</p></div><span class="count-pill">@Model.Count() @UiText.Get("students.title").ToLowerInvariant()</span></div>
  <div class="student-grid">@foreach (var student in Model) { <a class="student-card" asp-action="Details" asp-route-id="@student.Id"><span class="student-avatar">@student.FirstName[..1].ToUpperInvariant()@student.LastName[..1].ToUpperInvariant()</span><span class="student-info"><strong>@student.FirstName @student.LastName</strong><small>@student.Email</small></span><span class="student-arrow">→</span></a> }</div>
  @if (!Model.Any()) { <div class="empty-state compact"><span class="empty-icon">✓</span><h2>@UiText.Get("students.empty")</h2><p>@UiText.Get("students.emptyHint")</p></div> }
</section>
