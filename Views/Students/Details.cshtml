@model StudentIdentityPortal.ViewModels.StudentViewModel
@{ ViewData["Title"] = UiText.Get("students.title"); }
<section class="student-detail page-shell"><a class="back-link" asp-action="Index">← @UiText.Get("students.back")</a><article class="detail-card"><span class="detail-avatar">@Model.FirstName[..1].ToUpperInvariant()@Model.LastName[..1].ToUpperInvariant()</span><span class="status-pill"><span></span> @UiText.Get("students.title").ToUpperInvariant()</span><h1>@Model.FirstName @Model.LastName</h1><a href="mailto:@Model.Email" class="detail-email">@Model.Email</a><div class="welcome-divider"></div><div class="member-line"><span>@UiText.Get("students.joined")</span><strong>@Model.CreatedAt.ToLocalTime().ToString("MMMM yyyy")</strong></div></article></section>
