@model StudentIdentityPortal.ViewModels.ProfileViewModel
@{ ViewData["Title"] = UiText.Get("profile.title"); }
<section class="profile-page page-shell"><div class="page-heading"><div><div class="eyebrow">@UiText.Get("profile.eyebrow")</div><h1>@UiText.Get("profile.title").TrimEnd('.')<span class="text-accent">.</span></h1><p>@UiText.Get("profile.desc")</p></div></div>
 @if (TempData["Notice"] is string notice) { <div class="notice">@notice</div> }
 <div class="profile-layout"><div class="profile-summary"><span class="large-avatar">@Model.FirstName[..1].ToUpperInvariant()</span><h2>@Model.FirstName @Model.LastName</h2><p>@Model.Email</p><span class="member-tag">@UiText.Get("dash.memberSince") @Model.CreatedAt.ToLocalTime().ToString("MMMM yyyy")</span></div><form asp-action="Index" method="post" class="form-card profile-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-row"><div class="field"><label asp-for="FirstName">@UiText.Get("register.first")</label><input asp-for="FirstName" autocomplete="given-name" /><span asp-validation-for="FirstName" class="field-error"></span></div><div class="field"><label asp-for="LastName">@UiText.Get("register.last")</label><input asp-for="LastName" autocomplete="family-name" /><span asp-validation-for="LastName" class="field-error"></span></div></div><div class="field"><label asp-for="Email">@UiText.Get("profile.email")</label><input asp-for="Email" readonly class="readonly-input" /><small class="field-hint">@UiText.Get("profile.emailHint")</small></div><input asp-for="CreatedAt" type="hidden" /><button class="button button-primary button-large" type="submit">@UiText.Get("profile.save") <span>→</span></button></form></div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
