@model StudentIdentityPortal.ViewModels.ProfileViewModel
@{ ViewData["Title"] = "Your profile"; }
<section class="profile-page page-shell"><div class="page-heading"><div><div class="eyebrow">YOUR DETAILS</div><h1>Your profile<span class="text-accent">.</span></h1><p>Keep the information connected to your student identity up to date.</p></div></div>
 @if (TempData["Notice"] is string notice) { <div class="notice">@notice</div> }
 <div class="profile-layout"><div class="profile-summary"><span class="large-avatar">@Model.FirstName[..1].ToUpperInvariant()</span><h2>@Model.FirstName @Model.LastName</h2><p>@Model.Email</p><span class="member-tag">Member since @Model.CreatedAt.ToLocalTime().ToString("MMMM yyyy")</span></div><form asp-action="Index" method="post" class="form-card profile-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-row"><div class="field"><label asp-for="FirstName">First name</label><input asp-for="FirstName" autocomplete="given-name" /><span asp-validation-for="FirstName" class="field-error"></span></div><div class="field"><label asp-for="LastName">Last name</label><input asp-for="LastName" autocomplete="family-name" /><span asp-validation-for="LastName" class="field-error"></span></div></div><div class="field"><label asp-for="Email">Email address</label><input asp-for="Email" readonly class="readonly-input" /><small class="field-hint">Email changes are managed by your administrator.</small></div><input asp-for="CreatedAt" type="hidden" /><button class="button button-primary button-large" type="submit">Save profile <span>↗</span></button></form></div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
