@model StudentIdentityPortal.ViewModels.RegisterViewModel
@{ ViewData["Title"] = UiText.Get("register.title"); }
<section class="auth-shell page-shell">
  <div class="auth-aside"><div class="eyebrow">@UiText.Get("register.title")</div><h1>@UiText.Get("home.heading1")<br />@UiText.Get("home.heading2") <span class="text-accent">@UiText.Get("home.heading3")</span></h1><p>@UiText.Get("register.heading")</p><div class="aside-note"><span>✓</span><div><strong>@UiText.Get("home.feature1")</strong><small>@UiText.Get("home.feature1desc")</small></div></div><div class="aside-decoration">N<span>.</span></div></div>
  <div class="form-card"><div class="form-heading"><span class="form-kicker">@UiText.Get("register.title")</span><h2>@UiText.Get("register.join")</h2><p>@UiText.Get("register.haveAccount") <a asp-action="Login">@UiText.Get("nav.signin")</a></p></div>
    <form asp-action="Register" method="post" class="form-stack">
      <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
      <div class="form-row">
        <div class="field"><label asp-for="FirstName">@UiText.Get("register.first")</label><input asp-for="FirstName" autocomplete="given-name" /><span asp-validation-for="FirstName" class="field-error"></span></div>
        <div class="field"><label asp-for="LastName">@UiText.Get("register.last")</label><input asp-for="LastName" autocomplete="family-name" /><span asp-validation-for="LastName" class="field-error"></span></div>
      </div>
      <div class="field"><label asp-for="Email">@UiText.Get("register.email")</label><input asp-for="Email" autocomplete="email" placeholder="you@university.edu" /><span asp-validation-for="Email" class="field-error"></span></div>
      <div class="field"><label asp-for="Password">@UiText.Get("register.password")</label><div class="password-wrap"><input asp-for="Password" autocomplete="new-password" /><button type="button" class="password-toggle" aria-label="Show password">@UiText.Get("register.password")</button></div><span asp-validation-for="Password" class="field-error"></span><small class="field-hint">@UiText.Get("register.passwordHint")</small></div>
      <div class="field"><label asp-for="ConfirmPassword">@UiText.Get("register.confirm")</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
      <button class="button button-primary button-full button-large" type="submit">@UiText.Get("register.submit") <span aria-hidden="true">→</span></button><p class="form-legal">@UiText.Get("register.legal")</p>
    </form>
  </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
