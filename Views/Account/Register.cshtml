@model StudentIdentityPortal.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<section class="auth-shell page-shell"><div class="auth-aside"><div class="eyebrow">YOUR NEXT CHAPTER</div><h1>A good start<br />feels like <span class="text-accent">you.</span></h1><p>Create your student identity and make this space yours.</p><div class="aside-note"><span>✳</span><div><strong>Thoughtfully made</strong><small>A calm, clear space for your campus life.</small></div></div><div class="aside-decoration">N<span>.</span></div></div><div class="form-card"><div class="form-heading"><span class="form-kicker">CREATE YOUR ACCOUNT</span><h2>Join the portal</h2><p>Already have an account? <a asp-action="Login">Sign in</a></p></div><form asp-action="Register" method="post" class="form-stack">
  <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
  <div class="form-row"><div class="field"><label asp-for="FirstName">First name</label><input asp-for="FirstName" autocomplete="given-name" placeholder="e.g. Nazerke" /><span asp-validation-for="FirstName" class="field-error"></span></div><div class="field"><label asp-for="LastName">Last name</label><input asp-for="LastName" autocomplete="family-name" placeholder="Your surname" /><span asp-validation-for="LastName" class="field-error"></span></div></div>
  <div class="field"><label asp-for="Email">University email</label><input asp-for="Email" autocomplete="email" placeholder="you@university.edu" /><span asp-validation-for="Email" class="field-error"></span></div>
  <div class="field"><label asp-for="Password">Password</label><div class="password-wrap"><input asp-for="Password" autocomplete="new-password" placeholder="At least 8 characters" /><button type="button" class="password-toggle" aria-label="Show password">Show</button></div><span asp-validation-for="Password" class="field-error"></span><small class="field-hint">Use upper and lower case letters, a number and a symbol.</small></div>
  <div class="field"><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Type your password again" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
  <button class="button button-primary button-full button-large" type="submit">Create student account <span aria-hidden="true">↗</span></button><p class="form-legal">By continuing, you agree to use the portal respectfully and keep your account secure.</p>
</form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
